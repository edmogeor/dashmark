---
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro'
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro'

const { sidebar } = Astro.locals.starlightRoute
---

<SidebarPersister>
  <SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="sidebar-support">
  <p class="sidebar-support-copy">
    Authored by <a href="https://github.com/edmogeor" target="_blank" rel="noreferrer">@edmogeor</a>.<br />
    Support the development of Dashmark.
  </p>
  <a class="sidebar-support-button" href="https://www.buymeacoffee.com/edmogeor" target="_blank" rel="noreferrer">
    <img src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png" alt="Buy Me a Coffee" width="217" height="60" />
  </a>
</div>
