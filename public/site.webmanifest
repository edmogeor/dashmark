{
  "name": "Dashmark",
  "short_name": "Dashmark",
  "description": "A lightweight dashboard of links to your Docker services.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "background_color": "#0a0a0a",
  "theme_color": "#FF5A5F",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "brand/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
