---
export const prerender = true

import { Dashboard } from '@/components/Dashboard'
import { ThemeToggle } from '@/components/ThemeToggle'
import { getConfig } from '@/lib/config'
import { THEME_STORAGE_KEY } from '@/lib/constants'
import { demoServices } from '@/lib/demo'
import { resolveGreeting } from '@/lib/greeting'
import { resolveIcon } from '@/lib/icons'
import { strings } from '@/lib/strings'
import type { Card } from '@/lib/docker'
import '@/styles/global.css'

const config = getConfig()
const demoUser = { firstName: 'John', groups: ['admins', 'media', 'family'] }
const demoCards: Card[] = await Promise.all(demoServices.map(async ({ imageName, ...card }) => ({
  ...card,
  accessGroups: card.accessGroups ?? [],
  state: card.state ?? 'running',
  health: card.health ?? 'healthy',
  icon: await resolveIcon(config, { imageName, title: card.title, containerName: card.id })
})))
const greeting = resolveGreeting(config, demoUser)

const baseUrl = import.meta.env.BASE_URL
const origin = Astro.site ?? Astro.url.origin
const imageUrl = new URL(`${baseUrl}/brand/og-image.png`, origin).href
const pageUrl = new URL(`${baseUrl}/demo/`, origin).href
---

<!doctype html>
<html lang={strings.meta.lang} class="dark" data-theme-toggle-enabled="true">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>Dashmark - Demo</title>
    <meta name="description" content={strings.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={strings.app.title} />
    <meta property="og:title" content="Dashmark - Demo" />
    <meta property="og:description" content={strings.meta.description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Dashmark - Demo" />
    <meta name="twitter:description" content={strings.meta.description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <script is:inline define:vars={{ themeStorageKey: THEME_STORAGE_KEY }}>
      const stored = localStorage.getItem(themeStorageKey)
      document.documentElement.classList.toggle('dark', stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches)
    </script>
  </head>
  <body class="dashmark flex min-h-dvh flex-col bg-background text-foreground">
    <ThemeToggle client:load />
    <main class="dashmark-main w-full">
      <Dashboard
        client:load
        initialCards={demoCards}
        initialShowStatus
        initialShowBranding
        enableStatusPolling={false}
        mockStatusPolling
        showHeader
        showGroups
        greeting={greeting}
        userGroups={demoUser.groups}
      />
    </main>
  </body>
</html>
