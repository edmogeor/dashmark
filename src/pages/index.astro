---
import { Dashboard } from '@/components/Dashboard'
import { ThemeToggle } from '@/components/ThemeToggle'
import { getConfig } from '@/lib/config'
import { getCards } from '@/lib/docker'
import { getUser, hasAllowedAccess } from '@/lib/auth'
import { resolveGreeting } from '@/lib/greeting'
import { strings } from '@/lib/strings'
import { THEME_STORAGE_KEY } from '@/lib/constants'
import '@/styles/global.css'

const config = getConfig()
const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '')
const assetPath = (path: string) => `${basePath}${path}`
const origin = Astro.url.origin
const imageUrl = `${origin}${assetPath('/brand/og-image.png')}`
const { cards: initialCards, error: initialError } = await getCards(config, Astro.request.headers)
const user = getUser(config, Astro.request.headers)
const showStatusBadges = config.showStatus && hasAllowedAccess(user, config.statusBadgeAccess)
const showMetrics = config.showMetrics && hasAllowedAccess(user, config.metricsAccess)
const displayedGroupNames = new Set(initialCards.flatMap(card => card.access.map(entry => entry.toLowerCase())))
const displayedUserGroups = user.groups.filter(group => displayedGroupNames.has(group.toLowerCase()))
const greeting = resolveGreeting(config, user)
---

<!doctype html>
<html lang={strings.meta.lang} class="dark" data-theme-toggle-enabled={config.showThemeToggle ? 'true' : 'false'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>{strings.app.title}</title>
    <meta name="description" content={strings.meta.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={strings.app.title} />
    <meta property="og:title" content={strings.app.title} />
    <meta property="og:description" content={strings.meta.description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href={assetPath('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="192x192" href={assetPath('/brand/icon-192.png')} />
    <link rel="icon" type="image/png" sizes="512x512" href={assetPath('/brand/icon-512.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={assetPath('/brand/apple-touch-icon.png')} />
    <link rel="manifest" crossorigin="use-credentials" href={assetPath('/site.webmanifest')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={strings.app.title} />
    {config.customStylesheet && <link rel="stylesheet" href="/custom.css" />}
    <script is:inline define:vars={{ themeStorageKey: THEME_STORAGE_KEY }}>
      (function () {
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        const stored = localStorage.getItem(themeStorageKey)
        const useToggle = document.documentElement.dataset.themeToggleEnabled === 'true'
        const dark = useToggle ? (stored ? stored === 'dark' : systemDark) : systemDark
        document.documentElement.classList.toggle('dark', dark)
      })()
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        void navigator.serviceWorker.getRegistrations().then(registrations => {
          for (const registration of registrations) void registration.unregister()
        })
      }
    </script>
  </head>
  <body class="dashmark flex min-h-dvh flex-col bg-background text-foreground">
    {config.showThemeToggle && <ThemeToggle client:load />}

    <main class="dashmark-main my-auto w-full">
      <Dashboard
        client:load
        initialCards={initialCards}
        initialError={initialError}
        initialShowSearch={config.showSearch}
        initialShowStatus={showStatusBadges}
        initialShowMetrics={showMetrics}
        initialShowBranding={config.showBranding}
        statusPollIntervalMs={config.statusPollIntervalMs}
        categoryOrder={config.categoryOrder}
        showHeader={config.showHeader}
        showGroups={config.showGroupTags && displayedGroupNames.size > 0}
        greeting={greeting}
        userGroups={displayedUserGroups}
        initialOpenInNewTab={config.openInNewTab}
      />
    </main>
  </body>
</html>
