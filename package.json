{
  "name": "dashmark",
  "type": "module",
  "version": "0.3.0-alpha.16",
  "description": "A lightweight dashboard of links to your Docker services",
  "scripts": {
    "dev": "node scripts/dev-with-demo.mjs",
    "fetch-icons": "node scripts/fetch-icons.mjs",
    "fetch-descriptions": "node scripts/fetch-descriptions.mjs",
    "prebuild": "npm run fetch-icons && npm run fetch-descriptions",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "oxlint .",
    "generate:metrics-catalog": "node scripts/generate-metrics-catalog.mjs",
    "validate:metrics": "npm run generate:metrics-catalog -- --check && node scripts/validate-metrics.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@tanstack/virtual-core": "^3.17.7",
    "astro": "^7.2.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "framer-motion": "^13.1.0",
    "fuse.js": "^7.0.0",
    "got": "^15.1.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.469.0",
    "node-jq": "^6.3.1",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "sharp": "^0.35.3",
    "shadcn": "^4.16.2",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "tough-cookie": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.11.2",
    "oxlint": "^1.78.0",
    "socket.io": "^4.8.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
