/*
 * Copy this file to custom.css, mount it into the container, and set
 * CUSTOM_STYLESHEET=/data/custom.css.
 */

:root {
  /* Light surface variables:
   * --background
   * --card
   * --surface
   * --surface-hover
   * --surface-active
   * --popover
   * --secondary
   * --muted
   * --accent
   */
  /* Badge variables:
   * --dashmark-badge-color-0
   * --dashmark-badge-color-1
   * --dashmark-badge-color-2
   * --dashmark-badge-color-3
   * --dashmark-badge-color-4
   * --dashmark-badge-color-5
   * --dashmark-badge-color-6
   * --dashmark-badge-color-7
   * --dashmark-badge-color-8
   * --dashmark-badge-color-9
   * --dashmark-badge-color-10
   * --dashmark-badge-color-11
   */
  /* Chart variables:
   * --dashmark-chart-color-0
   * --dashmark-chart-color-1
   * --dashmark-chart-color-2
   * --dashmark-chart-color-3
   * --dashmark-chart-color-4
   * --dashmark-chart-color-5
   * --dashmark-chart-color-6
   * --dashmark-chart-color-7
   */
  /* Shared card-status and custom metric badge colors:
   * --dashmark-status-success
   * --dashmark-status-info
   * --dashmark-status-warning
   * --dashmark-status-error
   * --dashmark-status-disabled
  */
}

.dark {
  /* Dark surface variables:
   * --background
   * --card
   * --surface
   * --surface-hover
   * --surface-active
   * --popover
   * --secondary
   * --muted
   * --accent
   */
}

.dashmark {
  /* The document body and overall dashboard theme. */
}

.dashmark-main {
  /* The main page area containing the dashboard. */
}

.dashmark-content {
  /* The centered content container. */
}

.dashmark-card-gradient {
  /* The shared subtle gradient on cards and tooltips. */
}

.dashmark-results {
  /* The area containing dashboard results and states. */
}

.dashmark-header {
  /* The sticky header containing the greeting and search panel. */
}

.dashmark-greeting {
  /* The greeting heading. */
}

.dashmark-user-groups {
  /* The container for the current user's group badges. */
}

.dashmark-group-badge {
  /* An individual user group badge. */
}

.dashmark-search-panel {
  /* The card surrounding search and filters. */
}

.dashmark-brand {
  /* The Dashmark brand icon in the search panel. */
}

.dashmark-search {
  /* The search field container. */
}

.dashmark-search-input {
  /* The search text input. */
}

.dashmark-search-clear {
  /* The button that clears the search query. */
}

.dashmark-category-filter {
  /* The category filter trigger button. */
}

.dashmark-category-filter-menu {
  /* The category filter dropdown menu. */
}

.dashmark-category-filter-option {
  /* An option in the category filter menu. */
}

.dashmark-category-grid {
  /* The masonry layout containing category cards. */
}

.dashmark-category {
  /* An individual category card. */
}

.dashmark-category-header {
  /* The header area of a category card. */
}

.dashmark-category-title {
  /* The category name. */
}

.dashmark-category-apps {
  /* The grid of app cards within a category. */
}

.dashmark-app-grid {
  /* The app card grid when no categories are assigned. */
}

.dashmark-app-link {
  /* The link wrapping an app card. */
}

.dashmark-app-card {
  /* An individual app card. */
}

.dashmark-app-content {
  /* The content area inside an app card. */
}

.dashmark-app-icon {
  /* An app image icon or initials placeholder, including its static gradient and outline. */
}

.dashmark-app-icon::after {
  /* The app-icon glimmer shown when its card is hovered. */
}

.dashmark-app-title {
  /* The app title. */
}

.dashmark-app-url {
  /* The app URL shown below the title. */
}

.dashmark-app-status {
  /* The app status badge or loading indicator. */
}

.dashmark-app-resources {
  /* The resource metrics tooltip. */
}

.dashmark-app-resources-header {
  /* The tooltip header. */
}

.dashmark-app-resources-title {
  /* The resource metrics heading. */
}

.dashmark-app-resource-host {
  /* The Docker host badge in the resource tooltip. */
}

.dashmark-app-resources-list {
  /* The list of resource and custom metric rows. */
}

.dashmark-app-resource-metric {
  /* An individual metric row. Use [data-metric-key="cpu"] for a specific metric. */
}

.dashmark-app-resource-metric-label {
  /* An individual metric row label. */
}

.dashmark-app-resource-metric-value {
  /* The value container for an individual metric row. */
}

.dashmark-app-resource-metric-number {
  /* The displayed value or loading indicator. */
}

.dashmark-custom-metric-badge {
  /* A colored state badge configured with custom_metrics.<key>.color. */
}

.dashmark-metric-dialog {
  /* The metric chart modal. */
}

.dashmark-metric-dialog-header {
  /* The metric chart modal header. */
}

.dashmark-metric-dialog-title {
  /* The metric chart modal title. */
}

.dashmark-metric-dialog-close {
  /* The metric chart modal close button. */
}

.dashmark-metric-dialog-body {
  /* The metric chart modal body. */
}

.dashmark-metric-chart {
  /* The responsive metric chart container. */
}

.dashmark-metric-chart-svg {
  /* The rendered SVG chart. */
}

.dashmark-metric-chart-x-axis {
  /* The chart time axis. */
}

.dashmark-metric-chart-y-axis {
  /* The chart value axis. */
}

.dashmark-metric-chart-series {
  /* A rendered chart series. */
}

.dashmark-metric-chart-end-label {
  /* The current-value label attached to a series endpoint. */
}

.dashmark-metric-chart-tooltip {
  /* The chart hover tooltip. */
}

.dashmark-metric-chart-tooltip-time {
  /* The timestamp in the chart hover tooltip. */
}

.dashmark-metric-chart-tooltip-value {
  /* A series value in the chart hover tooltip. Use [data-series-key] for a specific series. */
}

.dashmark-metric-chart-tooltip-label {
  /* The series label in the chart hover tooltip. */
}

.dashmark-metric-chart-tooltip-number {
  /* The numeric value in the chart hover tooltip. */
}

.dashmark-metric-chart-legend {
  /* The multi-series chart legend. */
}

.dashmark-metric-chart-legend-item {
  /* A multi-series chart legend item. Use [data-series-key] for a specific series. */
}

.dashmark-metric-chart-legend-swatch {
  /* The color swatch in a chart legend item. */
}

.dashmark-empty-state {
  /* The state shown when no apps match. */
}

.dashmark-error {
  /* The area containing a dashboard loading error. */
}

.dashmark-error-panel {
  /* The error message panel. */
}

.dashmark-theme-toggle {
  /* The fixed theme toggle button. */
}

.dashmark-theme-toggle-control {
  /* The visible triangular control in the toggle. */
}

.dashmark-theme-toggle-icon {
  /* The sun or moon icon in the toggle. */
}
